{
  "name": "@entwico/eslint-config",
  "version": "3.0.0",
  "description": "Shared ESLint flat config (TS, React, Astro, Tailwind)",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/entwico/eslint-config"
  },
  "bugs": {
    "url": "https://github.com/entwico/eslint-config/issues"
  },
  "homepage": "https://github.com/entwico/eslint-config#readme",
  "keywords": [
    "eslint",
    "eslint-config",
    "flat-config",
    "typescript",
    "react",
    "astro",
    "tailwind",
    "astroscope"
  ],
  "author": "admin@entwico.com",
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "pnpm lint && pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm build",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile",
    "ci:publish": "changeset publish"
  },
  "dependencies": {
    "@astroscope/eslint-plugin": "1.1.0",
    "@entwico/astro-eslint-parser": "3.0.1",
    "@eslint-community/regexpp": "4.12.2",
    "@eslint-react/eslint-plugin": "5.18.0",
    "@eslint/css": "1.4.0",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.0.1",
    "@stylistic/eslint-plugin": "6.0.0-beta.4",
    "@typescript-eslint/parser": "8.65.0",
    "eslint-plugin-astro": "3.0.1",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-unicorn": "72.0.0",
    "globals": "17.7.0",
    "tailwind-csstree": "0.3.3",
    "typescript-eslint": "8.65.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/eslint": "^9.6.1",
    "@types/estree": "^1.0.9",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
